{
  "name": "jieyang1987.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "个人学术网站 - 论文管理工具",
  "scripts": {
    "add-paper": "node scripts/add-paper.js",
    "list-papers": "node scripts/add-paper.js --list",
    "manage": "node scripts/paper-manager.js",
    "check:zh": "node scripts/check-zh-pages.js",
    "check:en": "node scripts/check-en-pages.js && node scripts/check-en-home-sections.js",
    "check": "npm run check:zh && npm run check:en && npm run check:chips && npm run check:media && npm run check:carousel && npm run check:teaching && npm run check:awards && npm run check:links && npm run check:research && npm run check:join && npm run check:activities",
    "build:zh": "node scripts/build-zh-pages.js",
    "check:chips": "node scripts/check-chip-gallery.js",
    "check:media": "node scripts/check-home-media.js",
    "check:carousel": "node scripts/check-video-carousel.js",
    "check:teaching": "node scripts/check-home-teaching.js",
    "check:awards": "node scripts/check-paper-awards.js",
    "check:links": "node scripts/check-publication-links.js",
    "check:research": "node scripts/check-research-pages.js",
    "check:join": "node scripts/check-join-pages.js",
    "check:activities": "node scripts/check-activity-pages.js",
    "build:release": "node scripts/build-release.js",
    "check:release": "node scripts/check-release.js",
    "prepare:release": "npm run check && npm run check:cloudbase && npm run build:release && npm run check:release",
    "check:cloudbase": "node scripts/check-cloudbase-delta.js"
  },
  "devDependencies": {
    "pdf-parse": "^1.1.1"
  }
}
